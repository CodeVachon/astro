---
import { Icon, CloseIcon } from "~components/Icons";
import ThemeToggle from "~components/ThemeToggle.astro";
import Search from "~components/Search";
import { navItems, socialMediaItems } from "~lib/navigation";

interface Props {
    currentPath: string;
}

const { currentPath } = Astro.props;
---

<section id="flyout-menu" class="z-[1000]">
    <label id="backdrop" for="menu-toggle">
        <label for="menu-toggle">
            <CloseIcon
                className={"size-12 text-text-primary transition-colors duration-200 hover:text-primary"}
            />
        </label>
    </label>
    <div
        id="flyout-menu-content"
        class="flyout-content fixed bottom-0 right-0 top-0 h-screen w-[90vw] min-w-[300px] border-l border-primary/30 shadow-lg sm:w-[400px]"
    >
        <div
            class="absolute -top-[40%] bottom-auto left-0 right-0 -z-10 h-[180%] overflow-hidden"
        >
            <svg
                class="absolute bottom-0 left-0 right-0 top-0 h-full w-full text-primary"
                aria-hidden="true"
            >
                <defs>
                    <radialGradient id="glow-menu" cx="0%">
                        <stop offset="0%" stop-color="currentcolor" stop-opacity="0.3"></stop>
                        <stop offset="53.95%" stop-color="currentcolor" stop-opacity="0.06"></stop>
                        <stop offset="100%" stop-color="currentcolor" stop-opacity="0"></stop>
                    </radialGradient>
                </defs>
                <rect width="100%" height="100%" fill="url(#glow-menu)"></rect>
            </svg>
        </div>

        <nav class="flex h-full w-full flex-col justify-between overflow-y-auto">
            <ol>
                <li class="p-4">
                    <Search client:load />
                </li>
                {
                    navItems.map((item) => (
                        <li class={currentPath === item.href ? "bg-primary/20" : ""}>
                            <a
                                href={item.href}
                                title={`Go to ${item.name}`}
                                class="flex cursor-pointer items-center gap-6 p-4 no-underline transition duration-200 ease-in-out hover:bg-primary/10"
                            >
                                <Icon name={item.icon ?? "link"} className="size-10 text-primary" />
                                <span class="font-display text-lg tracking-wider">{item.name}</span>
                            </a>
                        </li>
                    ))
                }
            </ol>

            <ol>
                {
                    socialMediaItems.map(({ name, href, icon }) => (
                        <li>
                            <a
                                href={href}
                                target="_blank"
                                title={`Connect on ${name}`}
                                class="flex cursor-pointer items-center gap-6 p-4 no-underline transition duration-200 ease-in-out hover:bg-primary/10"
                            >
                                <Icon name={icon} className="size-10 text-primary" />
                                <span class="font-display text-lg tracking-wider">{name}</span>
                            </a>
                        </li>
                    ))
                }

                <li>
                    <label for="menu-toggle">
                        <div
                            class="flex cursor-pointer items-center gap-6 p-4 transition duration-200 ease-in-out hover:bg-primary/10"
                        >
                            <CloseIcon className={"size-10 text-primary"} />
                            <span class="font-display text-lg tracking-wider">Close</span>
                        </div>
                    </label>
                </li>
                <li class="p-4">
                    <ThemeToggle />
                </li>
            </ol>
        </nav>
    </div>
</section>

<style>
    .flyout-content {
        background-color: var(--color-bg-deep);
    }

    /* Light mode: darken text for readability */
    :global(html:not(.dark)) .flyout-content {
        border-left-color: color-mix(in oklch, var(--color-primary) 35%, transparent);
    }

    :global(html:not(.dark)) .flyout-content span {
        color: var(--color-text-primary);
    }
</style>
