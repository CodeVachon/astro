---
/**
 * Badge - Tag/category badge with neon glow styling
 * Supports optional hex shape and glow effects
 */

interface Props {
    href?: string;
    variant?: "default" | "outline" | "glow";
    size?: "sm" | "md" | "lg";
    class?: string;
}

const { href, variant = "default", size = "md", class: className = "" } = Astro.props;

const sizeClasses = {
    sm: "px-2 py-0.5 text-2xs",
    md: "px-3 py-1 text-xs",
    lg: "px-4 py-1.5 text-sm"
};

const variantClasses = {
    default: "bg-primary/20 text-primary border-primary/30",
    outline: "bg-transparent text-primary border-primary/50",
    glow: "bg-primary/10 text-primary border-primary/50 neon-glow-badge"
};

const baseClasses = [
    "inline-flex items-center gap-1.5 rounded border font-mono uppercase tracking-wider transition-all duration-200",
    sizeClasses[size],
    variantClasses[variant],
    className
];
---

{
    href ? (
        <a
            href={href}
            class:list={[
                ...baseClasses,
                "no-underline hover:bg-primary/30 hover:border-primary hover:text-white",
                variant === "glow" && "hover:neon-glow"
            ]}
        >
            <slot />
        </a>
    ) : (
        <span class:list={baseClasses}>
            <slot />
        </span>
    )
}

<style>
    .neon-glow-badge {
        box-shadow:
            0 0 4px oklch(0.75 0.18 195 / 0.3),
            inset 0 0 4px oklch(0.75 0.18 195 / 0.1);
    }

    .neon-glow-badge:hover {
        box-shadow:
            0 0 8px var(--color-primary),
            0 0 16px var(--color-primary),
            inset 0 0 4px oklch(0.75 0.18 195 / 0.2);
    }

    /* Light mode adjustments */
    :global(html:not(.dark)) .neon-glow-badge {
        box-shadow:
            0 0 4px oklch(0.5 0.18 195 / 0.3),
            inset 0 0 4px oklch(0.5 0.18 195 / 0.1);
    }
</style>
