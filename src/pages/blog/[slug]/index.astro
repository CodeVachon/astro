---
import dayjs from "dayjs";
import Layout from "~layouts/Layout.astro";
import { getCollection, getEntries, getEntry, render } from "astro:content";
import HexGrid from "~components/HexGrid.astro";
import MarkdownContent from "~components/MarkdownContent.astro";
import Badge from "~components/Badge.astro";
import DashboardPanel from "~components/DashboardPanel.astro";
import DataReadout from "~components/DataReadout.astro";
import TerminalHeader from "~components/TerminalHeader.astro";
import TOCPanel from "~components/TOCPanel";
import { GithubIcon } from "~components/Icons";

export async function getStaticPaths() {
    const allBlogPosts = await getCollection("blog", ({ data }) => {
        return !data.draft;
    });

    return allBlogPosts.map((blogPost) => ({
        params: {
            slug: blogPost.id
        }
    }));
}

const { slug } = Astro.params;

const entry = await getEntry("blog", slug);
const { Content } = await render(entry);

// Get related articles
const bolsterArticles = await Promise.all([
    getCollection("blog", ({ data }) => {
        return data.tags.some(
            (tag) =>
                entry.data.tags.some((articleTag) => articleTag.id === tag.id) &&
                entry.data.title !== data.title
        );
    }).then((articles) => articles.reverse().slice(0, 3)),
    await getCollection("blog", ({ data }) => {
        return (
            !data.tags.some(
                (tag) =>
                    entry.data.tags.some((articleTag) => articleTag.id === tag.id) &&
                    entry.data.title !== data.title
            ) && data.title !== entry.data.title
        );
    }).then((articles) => articles.reverse().slice(0, 3))
]).then((recordset) => recordset.flat().slice(0, 3));

const sharedArticles = await getCollection("blog", ({ id }) => {
    return (entry.data.relatedPosts ?? []).some((related) => related.id === id);
});

while (sharedArticles.length < 3) {
    const article = bolsterArticles.shift();
    if (article) {
        sharedArticles.push(article);
    } else {
        break;
    }
}

const tags = await getEntries(entry.data.tags);

// Calculate reading time (rough estimate)
const wordCount = entry.body?.split(/\s+/).length ?? 0;
const readingTime = Math.ceil(wordCount / 200);
---

<Layout
    title={entry.data.title}
    description={entry.data.description}
    sideWidth="half"
    headerImage={entry.data.image}
    publishDate={dayjs(entry.data.date).toISOString()}
>
    <div class="post-layout">
        {/* Main Article Panel */}
        <article class="article-panel">
            {/* Article Header */}
            <header class="article-header">
                <h1 class="article-title">{entry.data.title}</h1>

                {/* Data readout */}
                <DataReadout
                    items={[
                        { label: "date", value: dayjs(entry.data.date).format("YYYY-MM-DD") },
                        { label: "read", value: `${readingTime} min` },
                        { label: "words", value: wordCount.toLocaleString() }
                    ]}
                    inline
                    class="mt-4"
                />
            </header>

            {/* Article Content */}
            <div class="article-content">
                <MarkdownContent>
                    <Content />
                </MarkdownContent>
            </div>

            {/* Article Footer */}
            <footer class="article-footer">
                {/* Tags */}
                {
                    tags.length > 0 && (
                        <div class="tags-section">
                            <span class="section-label">Tags:</span>
                            <div class="tags-list">
                                {tags.map((tag) => (
                                    <Badge href={`/blog/tags/${tag.id}`} variant="glow" size="sm">
                                        {tag.data.name}
                                    </Badge>
                                ))}
                            </div>
                        </div>
                    )
                }

                {/* GitHub link */}
                <a
                    href={`https://github.com/CodeVachon/astro/blob/main/src/content/blog/${slug}.md`}
                    target="_blank"
                    class="github-link"
                >
                    <GithubIcon className="size-4" />
                    <span>View source on GitHub</span>
                </a>
            </footer>
        </article>

        {/* Sidebar Panels */}
        <aside class="sidebar-panels">
            {/* Table of Contents */}
            <div class="toc-wrapper">
                <TOCPanel client:load />
            </div>

            {/* Metadata Panel */}
            <DashboardPanel title="Metadata" status="active">
                <div class="metadata-content">
                    <div class="metadata-item">
                        <span class="meta-label">Published</span>
                        <span class="meta-value">{dayjs(entry.data.date).format("MMMM D, YYYY")}</span>
                    </div>
                    <div class="metadata-item">
                        <span class="meta-label">Reading Time</span>
                        <span class="meta-value">{readingTime} minutes</span>
                    </div>
                    <div class="metadata-item">
                        <span class="meta-label">Word Count</span>
                        <span class="meta-value">{wordCount.toLocaleString()}</span>
                    </div>
                    {
                        tags.length > 0 && (
                            <div class="metadata-item">
                                <span class="meta-label">Categories</span>
                                <span class="meta-value">{tags.length} tags</span>
                            </div>
                        )
                    }
                </div>
            </DashboardPanel>
        </aside>
    </div>

    {/* Related Articles */}
    {
        sharedArticles.length > 0 && (
            <section class="related-section">
                <TerminalHeader level={2}>Related Articles</TerminalHeader>
                <div class="mt-6">
                    <HexGrid posts={sharedArticles.slice(0, 3)} columns={3} variant="rounded" />
                </div>
            </section>
        )
    }
</Layout>

<style>
    .post-layout {
        display: grid;
        gap: 2rem;
        max-width: 1200px;
    }

    /* Only show 2-column layout at xl (1280px+) */
    @media (min-width: 1280px) {
        .post-layout {
            grid-template-columns: 1fr 280px;
            gap: 3rem;
        }
    }

    /* Article Panel */
    .article-panel {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .article-header {
        padding-bottom: 1.5rem;
        border-bottom: 1px solid oklch(0.75 0.18 195 / 0.15);
    }

    .article-title {
        font-family: var(--font-family-display);
        font-size: 2rem;
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: 0.02em;
        color: var(--color-primary);
    }

    @media (min-width: 768px) {
        .article-title {
            font-size: 2.5rem;
        }
    }

    .article-content {
        max-width: 750px;
    }

    .article-footer {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid oklch(0.75 0.18 195 / 0.15);
    }

    .tags-section {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .section-label {
        font-family: var(--font-family-mono);
        font-size: 0.75rem;
        color: var(--color-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .tags-list {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .github-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-family-mono);
        font-size: 0.875rem;
        color: var(--color-text-secondary);
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .github-link:hover {
        color: var(--color-primary);
        text-shadow: 0 0 8px var(--color-primary);
    }

    /* Sidebar */
    .sidebar-panels {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    @media (min-width: 1280px) {
        .sidebar-panels {
            position: sticky;
            top: 6rem;
            align-self: start;
        }
    }

    .toc-wrapper {
        display: none;
    }

    @media (min-width: 1280px) {
        .toc-wrapper {
            display: block;
        }
    }

    /* Metadata */
    .metadata-content {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .metadata-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: var(--font-family-mono);
        font-size: 0.75rem;
    }

    .meta-label {
        color: var(--color-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .meta-value {
        color: var(--color-primary);
    }

    /* Related Section */
    .related-section {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid oklch(0.75 0.18 195 / 0.1);
    }
</style>
