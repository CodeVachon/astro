---
import Layout from "~layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";
import HexGrid from "~components/HexGrid.astro";
import TerminalHeader from "~components/TerminalHeader.astro";
import NeonButton from "~components/NeonButton.astro";
import DashboardPanel from "~components/DashboardPanel.astro";
import MarkdownContent from "~components/MarkdownContent.astro";

// Get recent blog posts
const allBlogPosts = await getCollection("blog", ({ data }) => {
    return !data.draft;
});
const recentBlogPosts = allBlogPosts.reverse().slice(0, 6);

// Get homepage content
const homepageData = await getEntry("page", "homepage");
const { Content } = await render(homepageData);
---

<Layout title="Home" className="flex flex-col gap-12">
    {/* Hero section with about content */}
    <section class="hero-section">
        <DashboardPanel title="About" status="online" class="prose-panel">
            <MarkdownContent>
                <Content />
            </MarkdownContent>
        </DashboardPanel>
    </section>

    {/* Recent Posts Section */}
    <section class="posts-section">
        <header class="mb-8 flex items-center justify-between">
            <TerminalHeader level={2}>Recent Posts</TerminalHeader>
            <NeonButton href="/blog" size="sm">View All</NeonButton>
        </header>

        <HexGrid posts={recentBlogPosts} columns={3} variant="rounded" />
    </section>

    {/* Quick Links / Commands Section */}
    <section class="commands-section">
        <DashboardPanel title="Quick Commands" status="active">
            <div class="command-list">
                <a href="/blog" class="command-item">
                    <span class="command-prefix">$</span>
                    <span class="command-text">cd ~/blog</span>
                    <span class="command-desc">Browse all posts</span>
                </a>
                <a href="/blog/tags" class="command-item">
                    <span class="command-prefix">$</span>
                    <span class="command-text">ls -la ~/tags</span>
                    <span class="command-desc">View all tags</span>
                </a>
                <a href="/uses" class="command-item">
                    <span class="command-prefix">$</span>
                    <span class="command-text">cat uses.md</span>
                    <span class="command-desc">My setup & tools</span>
                </a>
                <a href="/code" class="command-item">
                    <span class="command-prefix">$</span>
                    <span class="command-text">git log --oneline</span>
                    <span class="command-desc">Recent projects</span>
                </a>
            </div>
        </DashboardPanel>
    </section>
</Layout>

<style>
    .hero-section {
        max-width: 800px;
    }

    .prose-panel :global(.prose) {
        max-width: none;
    }

    .prose-panel :global(h1) {
        font-family: var(--font-family-display);
        color: var(--color-primary);
        margin-bottom: 1rem;
    }

    .prose-panel :global(p) {
        color: var(--color-text-secondary);
        line-height: 1.8;
    }

    .posts-section {
        max-width: 1200px;
    }

    .commands-section {
        max-width: 600px;
    }

    .command-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .command-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        border-radius: 0.375rem;
        border: 1px solid transparent;
        text-decoration: none;
        transition: all 0.2s ease;
        font-family: var(--font-family-mono);
    }

    .command-item:hover {
        background: oklch(0.75 0.18 195 / 0.1);
        border-color: oklch(0.75 0.18 195 / 0.3);
        text-shadow: none;
    }

    .command-prefix {
        color: var(--color-accent);
        font-weight: 500;
    }

    .command-text {
        color: var(--color-primary);
        font-size: 0.875rem;
        flex-grow: 1;
    }

    .command-desc {
        color: var(--color-text-muted);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    /* Light mode */
    :global(html:not(.dark)) .command-item:hover {
        background: oklch(0.5 0.18 195 / 0.1);
        border-color: oklch(0.5 0.18 195 / 0.3);
    }
</style>
