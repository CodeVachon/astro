---
import { Picture, getImage } from "astro:assets";
import myImage from "../assets/me.png";
import { ClientRouter } from "astro:transitions";
import { fade } from "astro:transitions";
import GridBackground from "~components/GridBackground.astro";
import Sidebar from "~components/Sidebar.astro";
import FlyoutMenu from "~components/FlyoutMenu.astro";
import SiteFooter from "~components/SiteFooter.astro";
import { siteTitle, siteAuthor, defaultDescription } from "~lib/navigation";
import "./../styles/global.css";

interface Props {
    title: string;
    description?: string;
    sideWidth?: "full" | "half";
    headerImage?: {
        src: string;
        width: number;
        height: number;
        format: "png" | "jpg" | "jpeg" | "tiff" | "webp" | "gif" | "svg" | "avif";
    };
    className?: string;
    publishDate?: string;
}

const {
    title,
    description,
    sideWidth = "full",
    headerImage,
    className = "",
    publishDate
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const cardImage = headerImage ?? myImage;
const titleTemplate = [title, siteTitle].filter((v) => String(v).trim().length > 0).join(" | ");
const descriptionTemplate = description ?? defaultDescription;

const ogImgSrc = await getImage({ src: cardImage, width: 1200, height: 600, format: "jpg" });
---

<html lang="en" class="dark h-full antialiased" style="color-scheme: dark;" data-theme="cool-cyber">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
        <link rel="icon" href={`${Astro.site}me-300.png`} type="image/png" />
        <title>{titleTemplate}</title>
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={descriptionTemplate} />
        <meta name="referrer" content="no-referrer-when-downgrade" />
        <link rel="canonical" href={canonical} />

        <meta name="theme-color" content="#00d4ff" />
        <meta property="author" content={siteAuthor} />
        <meta name="article:author" content={siteAuthor} />
        <meta name="color-scheme" content="dark light" />
        <meta name="format-detection" content="telephone=no" />
        <meta name="msapplication-config" content="/browserconfig.xml" />
        <meta property="og:site_name" content="All About Christopher Vachon" />
        <meta property="og:type" content="article" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={descriptionTemplate} />
        <meta property="og:url" content={canonical} />
        <meta property="og:author" content={siteAuthor} />
        {publishDate && <meta property="article:published_time" content={publishDate} />}
        {publishDate && <meta property="article:modified_time" content={publishDate} />}
        <meta property="article:publisher" content="https://github.com/CodeVachon" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={descriptionTemplate} />
        <meta name="twitter:url" content={canonical} />

        <meta name="twitter:label1" content="Written by" />
        <meta name="twitter:data1" content={siteAuthor} />
        <meta name="twitter:site" content="@CodeVachon" />
        {
            cardImage && (
                <>
                    <meta name="twitter:image" content={new URL(ogImgSrc.src, Astro.site)} />
                    <meta name="twitter:image:alt" content={titleTemplate} />
                    <meta property="og:image:alt" content={titleTemplate} />
                    <meta
                        property="og:image"
                        content={
                            new RegExp("blog/[a-z0-9]+").test(canonical.toString())
                                ? String(canonical).replace(/\/$/, "") + "/og.png"
                                : new URL(ogImgSrc.src, Astro.site)
                        }
                    />
                    <meta property="og:image:width" content={"1200px"} />
                    <meta property="og:image:height" content={"600px"} />
                    <meta property="og:image:type" content="image/png." />
                </>
            )
        }

        <link
            rel="alternate"
            type="application/rss+xml"
            title={siteTitle}
            href={`${Astro.site}rss.xml`}
        />
        <ClientRouter />
    </head>
    <body
        class="relative min-h-screen min-w-[350px] bg-bg-deep text-text-primary lg:flex lg:flex-row lg:overflow-hidden"
    >
        <GridBackground opacity={0.025} size="md" fade={true} class="fixed inset-0 z-0" />

        <input type="checkbox" id="menu-toggle" title="Toggle the Mobile Navigation" />

        <Sidebar sideWidth={sideWidth} currentPath={Astro.url.pathname} />

        <section
            class="relative z-10 flex h-full flex-grow flex-col overflow-x-hidden lg:h-screen lg:overflow-y-auto"
            transition:animate={fade({ duration: "0.5s" })}
        >
            <main class:list={["flex-grow p-6 lg:py-24", className]} data-pagefind-body>
                {
                    headerImage && (
                        <figure class="header-image-wrapper -mx-6 -mt-6 mb-6 max-w-[1200px] overflow-hidden lg:-mt-24">
                            <Picture
                                inferSize={true}
                                src={headerImage as any}
                                class="w-full object-cover md:aspect-video"
                                alt={titleTemplate}
                                widths={[320, 640, 1280, 1920]}
                                formats={["webp", "jpg"]}
                                fallbackFormat="jpg"
                                loading="eager"
                            />
                            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-bg-deep via-transparent to-transparent" />
                        </figure>
                    )
                }
                <slot />
            </main>
            <SiteFooter />
        </section>

        <FlyoutMenu currentPath={Astro.url.pathname} />

        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-RREP1WR95X"></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", "G-RREP1WR95X");
        </script>
        <script is:inline>
            document.addEventListener("astro:before-swap", () => {
                const toggle = document.getElementById("menu-toggle");
                if (toggle.checked) {
                    toggle.checked = false;
                }
            });

            document.addEventListener("keydown", (ev) => {
                const toggle = document.getElementById("menu-toggle");
                if (ev.key === "Escape") {
                    if (toggle.checked) {
                        toggle.checked = false;
                    }
                }

                if (ev.code === "KeyK" && (ev.ctrlKey || ev.metaKey)) {
                    ev.preventDefault();
                    ev.stopPropagation();
                    if (toggle.checked) {
                        toggle.checked = false;
                    } else {
                        toggle.checked = true;
                        const input = document.querySelector("input[type=search]");
                        if (input) {
                            input.focus();
                        }
                    }
                }
            });
        </script>
    </body>
</html>

<style>
    .header-image-wrapper {
        position: relative;
    }

    .header-image-wrapper::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 50%;
        background: linear-gradient(to top, var(--color-bg-deep), transparent);
        pointer-events: none;
    }
</style>
